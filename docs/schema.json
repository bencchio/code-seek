{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://code-seek.dev/schemas/scan-v0.1.json",
  "title": "Code Seek Scan Result",
  "description": "Output schema for code-seek scan --format json",
  "type": "object",
  "required": [
    "version",
    "timestamp",
    "metrics",
    "files"
  ],
  "properties": {
    "version": {
      "type": "string",
      "description": "Code Seek version that produced this output"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp of the scan"
    },
    "duration_ms": {
      "type": "integer",
      "minimum": 0,
      "description": "Scan duration in milliseconds"
    },
    "metrics": {
      "type": "object",
      "required": [
        "total_files",
        "total_entities",
        "total_loc"
      ],
      "properties": {
        "total_files": {
          "type": "integer",
          "minimum": 0
        },
        "total_entities": {
          "type": "integer",
          "minimum": 0
        },
        "total_loc": {
          "type": "integer",
          "minimum": 0
        },
        "languages": {
          "type": "object",
          "description": "File count per language, e.g. {\"Rust\": 3, \"Python\": 5}",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "errors": {
      "type": "array",
      "description": "File-level syntax errors found during scan",
      "items": {
        "type": "object",
        "required": [
          "path",
          "count",
          "items"
        ],
        "properties": {
          "path": {
            "type": "string",
            "description": "Relative path to the file with errors"
          },
          "count": {
            "type": "integer",
            "minimum": 1
          },
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "line",
                "message"
              ],
              "properties": {
                "line": {
                  "type": "integer",
                  "minimum": 1
                },
                "message": {
                  "type": "string",
                  "description": "Tree-sitter error message (ERROR or MISSING)"
                }
              }
            }
          }
        }
      }
    },
    "files": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/file"
      }
    }
  },
  "definitions": {
    "file": {
      "type": "object",
      "required": [
        "path",
        "language",
        "loc",
        "has_errors",
        "entities"
      ],
      "properties": {
        "path": {
          "type": "string",
          "description": "Relative path from project root"
        },
        "language": {
          "type": "string",
          "enum": [
            "Rust",
            "C",
            "C++",
            "JavaScript",
            "TypeScript",
            "Python",
            "QML"
          ]
        },
        "loc": {
          "type": "integer",
          "minimum": 0,
          "description": "Effective lines of code (no blanks, no comments)"
        },
        "sha256": {
          "type": "string",
          "description": "SHA256 hex digest of file content",
          "pattern": "^[a-f0-9]{64}$"
        },
        "has_errors": {
          "type": "boolean",
          "description": "Whether Tree-sitter found syntax errors in this file"
        },
        "error_count": {
          "type": "integer",
          "minimum": 0
        },
        "imports": {
          "type": "array",
          "description": "Import/use/include/require statements (reserved for v0.2)",
          "items": {
            "type": "string"
          }
        },
        "entities": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/entity"
          }
        }
      }
    },
    "entity": {
      "type": "object",
      "required": [
        "type",
        "kind",
        "name",
        "entity_path",
        "loc",
        "start_line",
        "end_line"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "function",
            "method",
            "class",
            "struct",
            "trait",
            "impl",
            "interface",
            "enum",
            "module",
            "component"
          ],
          "description": "Canonical entity type (language-agnostic)"
        },
        "kind": {
          "type": "string",
          "description": "Language-specific kind, e.g. 'class', 'struct', 'trait', 'fn'"
        },
        "name": {
          "type": "string",
          "description": "Short name of the entity (may be '<anonymous>_N' for lambdas)"
        },
        "entity_path": {
          "type": "string",
          "description": "Canonical path using '>' separator, e.g. 'src/main.py > Parser > parse'"
        },
        "loc": {
          "type": "integer",
          "minimum": 0,
          "description": "Effective lines of code for this entity"
        },
        "start_line": {
          "type": "integer",
          "minimum": 1
        },
        "end_line": {
          "type": "integer",
          "minimum": 1
        },
        "signature": {
          "type": "string",
          "description": "Full signature or declaration line (e.g. 'def parse(self, text: str) -> AST')"
        },
        "children": {
          "type": "array",
          "description": "Nested entities (methods in a class, variants in an enum)",
          "items": {
            "$ref": "#/definitions/entity"
          }
        }
      }
    }
  }
}
