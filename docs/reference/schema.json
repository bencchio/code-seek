{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://code-seek.dev/schemas/scan-v0.2.json",
  "title": "Code Seek Scan Result",
  "description": "Output schema for code-seek scan --format json",
  "type": "object",
  "required": [
    "version",
    "scan_path",
    "total_files",
    "total_loc",
    "total_entities",
    "files"
  ],
  "properties": {
    "version": {
      "type": "string",
      "description": "Code Seek version that produced this output"
    },
    "scan_path": {
      "type": "string",
      "description": "Directory or file path that was scanned"
    },
    "total_files": {
      "type": "integer",
      "minimum": 0
    },
    "total_loc": {
      "type": "integer",
      "minimum": 0
    },
    "total_entities": {
      "type": "integer",
      "minimum": 0
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp of the scan (planned for v0.3.x)"
    },
    "duration_ms": {
      "type": "integer",
      "minimum": 0,
      "description": "Scan duration in milliseconds (planned for v0.3.x)"
    },
    "files": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/file"
      }
    }
  },
  "definitions": {
    "file": {
      "type": "object",
      "required": [
        "path",
        "language",
        "loc",
        "entity_count",
        "entities"
      ],
      "properties": {
        "path": {
          "type": "string",
          "description": "Relative path from project root"
        },
        "language": {
          "type": "string",
          "enum": [
            "Rust",
            "C",
            "C++",
            "Go",
            "JavaScript",
            "Python",
            "QML",
            "TypeScript"
          ]
        },
        "loc": {
          "type": "integer",
          "minimum": 0,
          "description": "Effective lines of code (no blanks, no comments)"
        },
        "entity_count": {
          "type": "integer",
          "minimum": 0
        },
        "sha256": {
          "type": "string",
          "description": "SHA256 hex digest of file content (planned for v0.3.x)",
          "pattern": "^[a-f0-9]{64}$"
        },
        "has_errors": {
          "type": "boolean",
          "description": "Whether Tree-sitter found syntax errors in this file (planned for v0.3.x)"
        },
        "error_count": {
          "type": "integer",
          "minimum": 0,
          "description": "Number of syntax errors in this file (planned for v0.3.x)"
        },
        "imports": {
          "type": "array",
          "description": "Import/use/include/require statements (planned for v0.3.x)",
          "items": {
            "type": "string"
          }
        },
        "entities": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/entity"
          }
        }
      }
    },
    "entity": {
      "type": "object",
      "required": [
        "entity_path",
        "name",
        "entity_type",
        "loc",
        "start_line",
        "end_line"
      ],
      "properties": {
        "entity_path": {
          "type": "string",
          "description": "Canonical path using '>' separator, e.g. 'src/main.py > Parser > parse'"
        },
        "name": {
          "type": "string",
          "description": "Short name of the entity (may be '<anonymous>_N' for lambdas)"
        },
        "entity_type": {
          "type": "string",
          "enum": [
            "Class",
            "Enum",
            "Function",
            "Impl",
            "Method",
            "Namespace",
            "Struct",
            "Trait"
          ],
          "description": "Canonical entity type (language-agnostic)"
        },
        "loc": {
          "type": "integer",
          "minimum": 0,
          "description": "Effective lines of code for this entity"
        },
        "start_line": {
          "type": "integer",
          "minimum": 1
        },
        "end_line": {
          "type": "integer",
          "minimum": 1
        },
        "kind": {
          "type": "string",
          "description": "Language-specific kind, e.g. 'struct', 'trait', 'fn' (planned for v0.3.x)"
        },
        "signature": {
          "type": "string",
          "description": "Full signature or declaration line (planned for v0.3.x)"
        },
        "children": {
          "type": "array",
          "description": "Nested entities (methods in a class, variants in an enum)",
          "items": {
            "$ref": "#/definitions/entity"
          }
        }
      }
    }
  }
}
